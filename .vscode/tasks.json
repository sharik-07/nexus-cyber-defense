{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NEXUS: backend",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe run.py",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "NEXUS: frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "NEXUS: start all",
      "dependsOn": ["NEXUS: backend", "NEXUS: frontend"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}